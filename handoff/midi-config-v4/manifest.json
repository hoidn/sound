 "partial_requirement_scopes": {
  "REQ-MIDI-USER-002": "Number enablement for every CC key and integer pad notes",
  "REQ-MIDI-USER-003": "Effective global channel, per-control channel keys, global-only controls, pad channel rules",
  "REQ-MIDI-USER-005": "Map-mode labels: ten exact tokens, absent default, key scope, 14-bit label above CC 95; value transforms of Absolute, Absolute14Bit and the eight relative modes for continuous, enumerated and other parameters, for either range order; the three takeover choices by preference position; Pick-Up and Value Scaling with previous data values, the previous value of a 14-bit pair and the sorted bounds; the values exempt from takeover; value tolerance tau per message, k tau after k relative messages in a row",
  "REQ-MIDI-USER-006": "Pad identity and documented 4x4 position only",
  "REQ-MIDI-USER-007": "Encoder compaction to parameter positions and bank span 1 or 2",
  "REQ-MIDI-USER-008": "Direct-bank selector compaction and named device button targets",
  "REQ-MIDI-USER-009": "Strip and mixer-bank target association; Send2 only with Send1 enabled",
  "REQ-MIDI-USER-010": "Master/cue/crossfader targets and their map-mode keys; their values follow the REQ-MIDI-USER-005 transforms; crossfader Absolute values exempt from takeover, crossfader Absolute14Bit pairs subject to it",
  "REQ-MIDI-USER-011": "Mixer button kind from MixerButtonsToggle",
  "REQ-MIDI-USER-012": "Fourteen transport keys and targets",
  "REQ-MIDI-USER-013": "Lexical rules listed in spec.md only"
 },
 "unreleased_requirements": [
  "REQ-MIDI-USER-001",
  "REQ-MIDI-USER-004"
 ],
 "compatibility_dimensions": {
  "configuration-interpretation": "static-derived expectations; reference execution not-run",
  "behavior": "runtime routing and effects not-run; effects other than the released value transforms excluded",
  "audio": "excluded",
  "ui": "excluded",
  "timing": "excluded",
  "project-files": "excluded",
  "parameter-values": "static-derived and extracted-execution values in value cases, compared within tau; reference execution not-run"
 },
 "expectation_provenance_labels": {
  "static-derived; not observed reference output": "derived from evidence about the pinned build, reviewed before sanitization; cases MIDI-CONFIG-001 to 127",
  "extracted execution of the original x86_64 code (glibc substitutions); arm64 equivalence inferred": "the original program's x86_64 code that turns each Control Change message into a parameter value (message and 14-bit half handling, the value computation and takeover) ran on the case's messages on a Linux x86_64 host, with glibc in place of the macOS system libraries; the run supplied the target parameter and the previous data values; the interpreted assignments, the previous-value rules and the takeover choice positions remain static-derived; cases MIDI-CONFIG-128 to 161; not run: a notification Pick-Up gives after it has decided a value, and the route that applies a value later instead of at once (the run applied each value at once)"
 },
 "exclusions": {
  "inputs_without_expectation": [
   "duplicate sections",
   "duplicate option names after case folding",
   "text before the first section header",
   "option lines without a delimiter",
   "indented or continuation lines",
   "% in any value",
   "non-ASCII bytes, CR line endings, or ASCII control characters other than the LF line ending, including tabs",
   "noninteger pad note; noninteger pad channel for an enabled pad note",
   "integer text longer than 640 characters in a pad note, or in a pad channel for an enabled pad note",
   "MixerButtonsToggle value that is not a listed Boolean",
   "any InvertMuteButtonFeedback key",
   "map-mode value that is not exactly one of the ten tokens",
   "two enabled assignments with the same MIDI address",
   "Send2KnobN enabled while Send1KnobN is not",
   "on/off target parameters, in every map mode",
   "an enabled assignment on number n + 32 and the channel of an Absolute14Bit control with number n",
   "a target parameter whose minimum equals its maximum; a stepped parameter with a non-integer minimum, maximum or current value; a current value outside the closed interval between minimum and maximum; a parameter that changes a value after it is set",
   "a Value Scaling move (the value moved by the travelled fraction), and every later value of its sequence, except in cases MIDI-CONFIG-129, 133, 137, 138, 143 to 145, 153, 155 and 161 (none of them is on a stepped parameter)",
   "a takeover comparison or test whose two sides lie within 8 tau of each other, other than p = n for one and the same data value, and every later value of its sequence, except in cases MIDI-CONFIG-149 and 152 to 161",
   "a target value n or p of a stepped parameter whose exact value lies within 8 tau of a half-integer, and every later value of its sequence",
   "other MIDI input during a value case, including running status; anything else that empties the record of previous data values, such as another control surface on the same input"
  ],
  "behavior": [
   "load-failure reporting and recovery",
   "profile discovery, naming, activation and reload",
   "button responses to data values, toggling, held seeking, nudge and tap timing",
   "bank navigation, bank contents, lock and activator effects",
   "strip-to-track addressing",
   "arm, solo and select interactions",
   "pad playback and note lifetime",
   "MIDI feedback and mute feedback inversion",
   "collisions and competing mappings",
   "UI presentation",
   "persistence, undo and automation",
   "latency, cancellation, disconnect and teardown with held controls",
   "values of on/off parameters",
   "when a value is applied; ordering, coalescing and deferral of messages sent back to back; latency",
   "displayed values and any change a parameter makes to a value after it is set",
   "which application parameter a target is, and its kind, range and stepping",
   "the default takeover choice, the displayed wording of the three choices, and any notification or display while takeover holds a value"
  ]
 },
 "stated_assumptions": [
  "The macOS arm64 build computes the extracted-execution values as the x86_64 build does, except that it rounds once where the x86_64 build rounds twice when it forms the target value of an absolute message; the results then differ by at most one binary32 unit in the last place of max(|min|, |max|), none when the smaller bound is 0, which tau covers. Cases MIDI-CONFIG-128 to 161 depend on it.",
  "The application passes this code the parameter's reported range, kind and stepping, its current value and the previous data values as the contract states them, and the parameter keeps the value set on it. Every value case depends on it.",
  "The three preference entries, which select none, pick-up and value-scaling by position, display as None, Pick-Up and Value Scaling; their wording was not read. Only the labels used in a reference run depend on it."
 ],
 "value_tolerance": "tau = max(1e-6, 2^-22 * max(|min|, |max|)) absolute, with the case parameter's min and max; 1e-6 for cases MIDI-CONFIG-110 to 127; tau covers one message: a value reached by k relative messages in a row on a parameter that is not stepped is compared within k * tau",
 "fixture_origin": "independently authored ASCII configuration inputs, expected logical assignments, MIDI byte sequences, parameter descriptions and expected values",
 "approved_public_sources": [],
 "review": {
  "status": "approved",
  "reviewers": [
   "separate review agent (Claude Opus 5.5) in a coordinator-launched handoff-review context; not the author; will not implement"
  ],
  "date": "2026-10-18",
  "findings": [
   "RV4-01 low: stepped target values within single-precision rounding of a half-integer can round the other way (14-bit pairs, stepped ranges from 0 to 5000 up); narrowed with the 8 tau band; narrows a midi-config-v3 clause, no case affected",
   "RV4-02 low: rounding adds up over relative messages in a row (re-run of the original code: 5.2 tau after 200 messages); compared within k * tau; no case or comparator changed",
   "RV4-03 low: change list missed the comparison obligations; strict-superset wording no longer accurate; completed and reworded",
   "RV4-04 low: extracted-execution definition did not name the two parts of the code that did not run; named",
   "RV4-05 editorial: a stepped parameter's value after a Value Scaling move has no expectation; clarified",
   "RV4-06 info: the author's Value Scaling error figure was sampled; the true error reaches hundreds of tau; exclusion upheld",
   "RV4-07 info: evidence identity re-hashed, evidence run reproduced byte for byte, every new case re-run",
   "RV4-08 info: catalog wording outside the package not edited",
   "RV4-09 editorial: payload status set to reviewed release; review record added"
  ],
  "disposition": "Approved with listed narrowing (RV4-01) and clarifications (RV4-02 to RV4-05), only for the explicit partial clauses; expectations static-derived or extracted execution as labeled; reference and candidate execution not-run; restricted implementation workspace required",
  "record": "REVIEW.md"
 },
 "supersedes": "midi-config-v3",
 "supersession": {
  "relationship": "superset with two precision corrections to general midi-config-v3 value clauses: a value reached by k relative messages in a row is compared within k * tau, and a stepped target value within 8 tau of a half-integer has no expectation; no midi-config-v3 case affected; midi-config-v3 stays immutable and valid for its own scope apart from those corrections",
  "superseded_manifest_sha256": "2e7d93767bbb9fffa79cec191b242d7eec52aeb1d20f6f33f1bbdc0beff40458",
  "restated_cases": "MIDI-CONFIG-001 to 127: case records and fixture bytes identical to midi-config-v3",
  "corrected_expectations": "none; parent revision 5 corrected no expectation of a midi-config-v3 case",
  "changes": [
   "REQ-MIDI-USER-005 takeover: Pick-Up and Value Scaling specified, with the record of previous data values, the previous value of a 14-bit pair, the sorted bounds and inclusive comparisons; the three choices named none, pick-up and value-scaling and selected by preference position",
   "the midi-config-v3 assumption that the never-acting choice is the one labelled None is narrowed: which entry selects which choice is now static-derived; only the displayed wording is assumed",
   "reversed ranges: min below max is no longer required; Absolute, Absolute14Bit and relative values and takeover hold for either order, a stepped relative step moves toward max when d > 0",
   "REQ-MIDI-USER-010: crossfader Absolute14Bit pairs are subject to takeover (midi-config-v3 left them without expectation under the other two choices)",
   "value tolerance tau = max(1e-6, 2^-22 * max(|min|, |max|)) replaces 1e-6; tau is 1e-6 for every midi-config-v3 case; a value reached by k relative messages in a row on a parameter that is not stepped is compared within k * tau, because rounding adds up (midi-config-v3: 1e-6); each step of the carried relative cases is exact",
   "stepped rounding: a Value Scaling move is not rounded; a stepped parameter's value after a move has no expectation",
   "exclusions: removed values subject to takeover under the choices other than none, and min above max; min equal to max stays excluded; added tests within 8 tau of a bound, stepped target values within 8 tau of a half-integer (narrowing the midi-config-v3 rounding rule for such values; no midi-config-v3 case affected) and Value Scaling moves outside the listed cases, with the later values of their sequences, and anything that empties the record of previous data values; the default choice stays excluded, the displayed wording of the choices and any takeover notification are listed",
   "provenance: the extracted-execution label is new and carried by every new case; carried cases keep the static-derived label; stated assumptions revised; the parts of the original code that did not run are named",
   "representation: takeover gains pick-up and value-scaling; the initial value is stated to be a binary32 number; the values note and new comparators state tau",
   "comparison obligations: each choice selected by its entry position with the wording recorded, instead of confirming the never-acting choice; the crossfader rescaling rule extended to MIDI-CONFIG-150",
   "cases MIDI-CONFIG-128 to 161 added (34 value cases)",
   "no midi-config-v3 case, fixture or expectation changed; apart from the two precision corrections, nothing in midi-config-v3 is contradicted or narrowed; the sentences that left takeover unspecified now point to the new rules"
  ]
 },
