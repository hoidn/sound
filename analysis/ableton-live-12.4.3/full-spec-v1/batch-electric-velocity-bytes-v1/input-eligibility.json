      "text": "WARM = {44100: 11264, 48000: 12288}           # 22 * 512 = 256 * 44; 24 * 512 = 256 * 48\nBLOCK = 512\n"
    },
    {
      "source_pin": {
        "path": "/home/ollie/Documents/sound/analysis/ableton-live-12.4.3/r2/t12-electric-v1/el.py",
