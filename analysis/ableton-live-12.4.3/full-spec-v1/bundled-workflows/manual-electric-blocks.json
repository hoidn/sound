  },
  {
    "device": "electric",
    "kind": "p",
    "text": "The Global section contains the parameters that relate to the overall behavior and performance of Electric.",
    "heading_context": [
      {
        "level": 2,
        "text": "31.5 Electric",
        "html_line": 944,
        "anchor": "electric",
        "section": "31.5"
      },
      {
        "level": 3,
        "text": "31.5.5 Global Section",
