  "source_questions": [
    {
      "id": "SISA-Q01",
      "local_blocks": [
        "sampler:B062",
        "sampler:B049"
      ],
      "question": "Full127keywording versusC-2–G8namedrange retainedambiguous; no127/128endpoint, MIDIintegeralias, inclusiveedge or importconstructor resolution.",
      "quotes": [
        {
          "local_block": "sampler:B049",
          "pointer": "/blocks/70/text",
          "quote": "Distribute Ranges Equally — Distributes samples evenly across the editor’s full MIDI note range (C-2 to G8)."
        },
        {
          "local_block": "sampler:B062",
          "pointer": "/blocks/83/text",
          "quote": "Key zones define the range of MIDI notes over which each sample will play. Samples are only triggered when incoming MIDI notes lie within their key zone. Every sample has its own key zone, which can span anywhere from a single key up to the full 127."
        }
      ],
      "documentary_expected": null,
      "documentary_comparison": null,
      "actual_expected": null,
      "actual_comparison": null,
      "target": "U",
      "executed": false,
      "complete": false,
      "coverage_credit": 0
    },
    {
      "id": "SISA-Q02",
      "local_blocks": [
        "sampler:B036",
        "sampler:B040",
        "sampler:B041",
        "sampler:B042"
      ],
      "question": "RRcurrentmanualversion/unequalvelocity-selectorranges/oneeligibleOther/resettransport unknown; no mandatoryboundedrandomoutcome, seed or targetavailability fromnames.",
      "quotes": [
        {
          "local_block": "sampler:B036",
          "pointer": "/blocks/57/text",
          "quote": "Once enabled, any samples in the sample layer list that share the same key zone can be triggered when a note within that range is played."
        },
        {
          "local_block": "sampler:B040",
          "pointer": "/blocks/61/text",
          "quote": "Other — Cycles through samples randomly; the same sample will never be triggered twice in a row."
        },
        {
          "local_block": "sampler:B041",
          "pointer": "/blocks/62/text",
          "quote": "Random — Cycles through samples randomly; multiple retriggers of the same sample are possible."
        },
        {
          "local_block": "sampler:B042",
          "pointer": "/blocks/63/text",
          "quote": "You can set a specific interval at which the cycle restarts via the Reset Interval chooser. This is useful for triggering samples predictably and consistently. For example, if the Round Robin Mode is set to Forward with a reset interval of 1 bar, the topmost sample triggers on the first note of each bar. In Backward mode, the cycle restarts from the bottommost sample. In Other or Random mode, the cycle restarts from the sample that was first played."
        }
      ],
      "documentary_expected": null,
      "documentary_comparison": null,
      "actual_expected": null,
      "actual_comparison": null,
      "target": "U",
      "executed": false,
      "complete": false,
      "coverage_credit": 0
    },
    {
      "id": "SISA-Q03",
      "local_blocks": [
        "sampler:B091",
        "sampler:B094",
        "sampler:B095",
        "sampler:B161"
      ],
      "question": "EnvelopeEndsourcequalification LFO/Filter/PitchONLY mustnot mintVolumeEndUI fromgeneral011wording. Beat/SyncRepeatcurrentlevel→Peak versusInitialrestart contexts retained separately, no synthesizedequalclock/envelope law.",
      "quotes": [
        {
          "local_block": "sampler:B091",
          "pointer": "/blocks/112/text",
          "quote": "Envelope End Level (End) — (LFO, Filter and pitch envelopes only) This is the level reached at the end of the Release stage."
        },
        {
          "local_block": "sampler:B094",
          "pointer": "/blocks/115/text",
          "quote": "Envelope Beat/Sync Rate (Repeat) — The envelope will be retriggered after this amount of beat-time, as long as it is still on. When retriggered, the envelope will move at the given attack rate from the current level to the peak level."
        },
        {
          "local_block": "sampler:B095",
          "pointer": "/blocks/116/text",
          "quote": "Envelope Loop Time (Time) — If a note is still on after the end of the decay/sustain segment, the envelope will start again from its initial value. The time it takes to move from the sustain level to the initial value is defined by this parameter."
        },
        {
          "local_block": "sampler:B161",
          "pointer": "/blocks/182/text",
          "quote": "This envelope can also be looped via the Loop chooser. When a Loop mode is selected, the Time/Repeat slider becomes important. For Loop and Trigger modes, if a note is still held when the Decay stage ends, the envelope will restart from its initial value. The time it takes to move from the Sustain level to the initial value is defined by the Time parameter. For Beat and Sync modes, if a note is still held after the amount set in the Repeat slider, the envelope will restart from its initial value."
        }
      ],
      "documentary_expected": null,
      "documentary_comparison": null,
      "actual_expected": null,
      "actual_comparison": null,
      "target": "U",
      "executed": false,
      "complete": false,
      "coverage_credit": 0
    },
    {
      "id": "SISA-Q04",
      "local_blocks": [
        "sampler:B099",
        "sampler:B108",
        "sampler:B110",
        "sampler:B111"
      ],
      "question": "SampleEndexception correctedUNLOOPED ONLY preserved; forward/back-and-forthrelease controlsexceptions. Empty-altimageatB108doesnotvisuallyproveexactOffglyph/labelassociation; timing/order/roundingU.",
      "quotes": [
        {
          "local_block": "sampler:B099",
          "pointer": "/blocks/120/text",
          "quote": "Sample End — The time value where playback will end (unless a loop is enabled), even if the volume envelope has not ended."
        },
        {
          "local_block": "sampler:B108",
          "pointer": "/blocks/129/text",
          "quote": "— The volume envelope’s release stage is active, but will occur within the Sustain Loop, with playback never proceeding beyond Loop End."
        },
        {
          "local_block": "sampler:B110",
          "pointer": "/blocks/131/text",
          "quote": "Release Loop Enabled — When the volume envelope reaches its release stage, playback will proceed linearly until reaching Sample End, where it jumps immediately to Release Loop and continues looping until the volume envelope has completed its release stage."
        },
        {
          "local_block": "sampler:B111",
          "pointer": "/blocks/132/text",
          "quote": "Back-and-Forth Release Loop Enabled — When the volume envelope reaches its release stage, playback will proceed linearly until reaching Sample End, then reverses until it reaches Release Loop, then proceeds again towards Sample End. This pattern continues until the volume envelope has completed its release stage."
        }
      ],
      "documentary_expected": null,
      "documentary_comparison": null,
      "actual_expected": null,
      "actual_comparison": null,
      "target": "U",
      "executed": false,
      "complete": false,
      "coverage_credit": 0
    },
    {
      "id": "SISA-Q05",
      "local_blocks": [
        "simpler:B004",
        "simpler:B033",
