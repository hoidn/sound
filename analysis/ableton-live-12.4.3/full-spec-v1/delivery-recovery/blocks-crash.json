[
  {
    "kind": "p",
    "text": "If Live has crashed, you can use the steps below to help restore stable performance and determine the cause.",
    "body_html_line": 1,
    "anchor": null,
    "heading_context": [],
    "id": "CRASH-B001",
    "source_id": "HELP-CRASH-API",
    "source_pointer": "/article/body"
  },
  {
    "kind": "p",
    "text": "Important tips:",
    "body_html_line": 2,
    "anchor": null,
    "heading_context": [],
    "id": "CRASH-B002",
    "source_id": "HELP-CRASH-API",
    "source_pointer": "/article/body"
  },
  {
    "kind": "li",
    "text": "To test with third-party plug-ins disabled, hold [ALT/OPTION] while re-starting Live.",
