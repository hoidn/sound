    "heading_context": [],
    "id": "CRASH-B003",
    "source_id": "HELP-CRASH-API",
    "source_pointer": "/article/body"
  },
  {
    "kind": "li",
    "text": "Although re-installing the Live application may be necessary in rare cases, before doing this please first try resetting Live's preferences to the original default state.",
