    "source_id": "HELP-CRASH-API",
    "source_pointer": "/article/body"
  },
  {
    "kind": "li",
    "text": "Quit Live.",
    "body_html_line": 59,
    "anchor": null,
    "heading_context": [
      {
        "level": 2,
        "text": "4. If Live crashes on launch",
        "body_html_line": 54,
